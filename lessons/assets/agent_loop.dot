// docs/templates/flow_diagram.dot의 색·글꼴·여백을 적용한 1.1.3 도식 원본.
// 재생성: dot -Tsvg lessons/assets/agent_loop.dot -o lessons/assets/agent_loop.svg
digraph AgentLoop {
  graph [rankdir=LR, bgcolor="white", pad="0.28", nodesep="0.48", ranksep="0.66", splines=polyline];
  node [shape=box, style="rounded,filled", color="#B8C9DE", fillcolor="#F3F7FC", fontname="Noto Sans KR", fontsize=17, margin="0.16,0.13"];
  edge [color="#55769A", arrowsize=0.7, penwidth=1.5];

  question [label="사용자 질문", fillcolor="#E8F0FF"];
  decide [label="다음 행동 판단\n(모델)", fillcolor="#DDEBFF"];
  request [label="도구 이름·인자 제안\n(모델)", fillcolor="#DDEBFF"];
  validate [label="허용 도구·인자 검사\n(프로그램)", fillcolor="#FFF2DA"];
  execute [label="도구 실행\n(프로그램)", fillcolor="#FFF2DA"];
  observe [label="실행 결과 관찰", fillcolor="#E7F5F1"];
  answer [label="근거 있는 답변", fillcolor="#E7F5F1"];
  stop [label="중단·오류 보고", fillcolor="#FCEBE9"];

  question -> decide;
  decide -> request;
  request -> validate -> execute -> observe;
  observe -> decide [constraint=false];
  decide -> answer;
  validate -> stop;
  decide -> stop;
}
