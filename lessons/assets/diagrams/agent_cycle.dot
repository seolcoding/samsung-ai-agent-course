// docs/templates/flow_diagram.dot 스타일을 확장한 교안 도식 원본.
digraph Lesson {
graph [rankdir=LR,bgcolor="#FCFBF7",pad="0.35",nodesep="0.5",ranksep="0.6"]; node [shape=box,style="rounded,filled",fontname="Noto Sans KR",fontsize=19,color="#BDD0E4",fillcolor="#E8F0FF",fontcolor="#15324F",margin="0.2,0.16"]; edge [fontname="Noto Sans KR",fontsize=14,color="#55769A",arrowsize=0.8,penwidth=1.6];
q [label="질문",fillcolor="#E8F0FF"];
m [label="모델\n다음 행동 제안",fillcolor="#E8F0FF"];
v [label="프로그램\n인자·권한 검사",fillcolor="#FFF0D9"];
t [label="도구 실행",fillcolor="#FFF0D9"];
o [label="관찰 결과",fillcolor="#E4F4EF"];
a [label="최종 답변",fillcolor="#FFF0D9"];
e [label="오류·한도 중단",fillcolor="#FFF0D9"];
q -> m [label=""];
m -> v [label="도구 필요"];
v -> t [label="허용"];
t -> o [label=""];
o -> m [label="다음 판단"];
m -> a [label="근거 충분"];
v -> e [label="실패"];
m -> e [label="한도"];
}
