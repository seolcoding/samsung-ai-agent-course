# -----------------------------------------------------------------------------
# AI Agent course - connection settings template
#
# How to use
#   1. Copy this file to the top of the repository and name the copy .env. The notebooks read only .env.
#   2. In (1) below, set COURSE_ENV to samsung (inside the company network) or out (outside it).
#   3. Fill in only the section for the environment you chose: (2) inside or (3) outside.
#      The instructor tells you the values. The inside values are on the internal
#      training page (environment / API key setup guide).
#   4. Check: from the top of the repository run  uv run python -m config.check
#      (or run the environment check cell at the top of a notebook).
#      You are done when no line has a no-entry sign. For each line that has one,
#      follow the hint printed under it.
#
# Rules: never print key or token values, and never paste them into chat, email or git.
# .env is never committed to git.
# Details and troubleshooting: course/agent_docs/setup.md, course/agent_docs/troubleshooting.md
# -----------------------------------------------------------------------------


# (1) Environment: set only this one line. config sets up the other connections to match.
#    samsung  inside the company network (classroom PC) - LLM, embeddings and RAGaaS all use the internal APIs. Fill in (2).
#    out      outside the company network               - LLM and embeddings use OpenAI, RAGaaS returns mock answers. Fill in (3).
COURSE_ENV=samsung

# (Advanced) Remove the leading # only if you want to choose each connection separately. A value set here wins over COURSE_ENV.
# LLM_PROVIDER=samsung      # samsung or openai
# EMBED_PROVIDER=samsung    # samsung or openai
# RAG_PROVIDER=samsung      # samsung or mock


# (2) Inside values - fill these in when COURSE_ENV=samsung -----------------------

# LLM gateway (all 5 values are required)
# Gateway URL. Do not add /chat/completions at the end (the code adds it).
api_base_url=
# x-dep-ticket credential
credential_key=
# Send-System-Name written in the approval document
send_system_name=
# Model name. The original code used private-model.1-260330 (the value on the training page takes priority).
model=
# Your AD ID
user_id=

# Embeddings (1-4 RAG, 2-3 Streamlit)
# Embedding API URL. Do not add /v1/embeddings at the end (the code adds it).
embedding_api_url=
embedding_x_dep_ticket=

# RAGaaS (the RAGaaS chapter of 1-4). Both credentials are required.
# RAGaaS URL
search_url=
# x-dep-ticket credential
rag_credential_key=
# api-key header value
rag_api_key=
# Training index used by the original code (pet insurance terms)
index_name=rp-aicoa-meritz-pet


# (3) Outside values - fill these in when COURSE_ENV=out --------------------------

OPENAI_API_KEY=
# Example: a model name your account can use, such as gpt-4o-mini
OPENAI_MODEL=
# Example: text-embedding-3-small
OPENAI_EMBEDDING_MODEL=


# (4) Langfuse - fill these in only for the Part 2 (Chapter02) observability labs ---

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
