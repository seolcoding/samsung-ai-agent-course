# ─────────────────────────────────────────────────────────────────────────────
# AI Agent 개발 과정 — 연결 설정 견본
#
# 쓰는 법
#   1. 이 파일을 저장소 맨 위에 .env 라는 이름으로 복사한다. 노트북은 .env만 읽는다.
#   2. 아래 ① 에서 실행 환경을 하나만 고른다(사내 / 사외).
#   3. 고른 환경의 칸(② 사내 또는 ③ 사외)만 채운다. 값은 강사가 알려 준다.
#      사내 값은 사내 교육 페이지(환경·API 키 세팅 안내)에 있다.
#   4. 노트북 맨 위 "환경 점검" 셀을 실행해 "준비 완료"가 나오는지 본다.
#
# 지킬 것: 키·토큰 값은 화면에 출력하거나 채팅·메일·깃에 올리지 않는다. .env는 깃에 올라가지 않는다.
# 자세한 설명과 오류 해결: course/agent_docs/setup.md, course/agent_docs/troubleshooting.md
# ─────────────────────────────────────────────────────────────────────────────


# ① 실행 환경: 둘 중 하나의 세 줄만 남기고, 다른 세 줄은 앞에 #을 붙인다.

# [사내] 삼성 인트라넷(강의장 PC). 사내망에서만 동작한다.
LLM_PROVIDER=samsung
EMBED_PROVIDER=samsung
RAG_PROVIDER=samsung

# [사외] 사내망 밖(강사 준비용). OpenAI를 쓰고, RAGaaS는 모의 응답(mock)으로 흐름만 본다.
# LLM_PROVIDER=openai
# EMBED_PROVIDER=openai
# RAG_PROVIDER=mock


# ② 사내 값 ─ ① 에서 [사내]를 골랐을 때 채운다 ───────────────────────────────

# LLM 게이트웨이 (5개 모두 필요)
# 게이트웨이 주소. 끝에 /chat/completions는 붙이지 않는다(코드가 붙인다)
api_base_url=
# x-dep-ticket 인증값
credential_key=
# 결재 문서에 적은 Send-System-Name
send_system_name=
# 모델 이름. 받은 원본 코드는 private-model.1-260330 을 썼다(교육 페이지 값이 우선)
model=
# 사용자 AD ID
user_id=

# 임베딩 (1-4 RAG, 2-3 Streamlit)
# 임베딩 API 주소. 끝에 /v1/embeddings는 붙이지 않는다(코드가 붙인다)
embedding_api_url=
embedding_x_dep_ticket=

# RAGaaS (1-4의 RAGaaS 장). 인증값 두 개가 모두 있어야 한다.
# RAGaaS 주소
search_url=
# x-dep-ticket 인증값
rag_credential_key=
# api-key 헤더 값
rag_api_key=
# 받은 원본 코드의 교육용 인덱스(펫보험 약관)
index_name=rp-aicoa-meritz-pet


# ③ 사외 값 ─ ① 에서 [사외]를 골랐을 때 채운다 ───────────────────────────────

OPENAI_API_KEY=
# 예: gpt-4o-mini 처럼 계정에서 쓸 수 있는 모델 이름
OPENAI_MODEL=
# 예: text-embedding-3-small
OPENAI_EMBEDDING_MODEL=


# ④ Langfuse ─ 2부(Chapter02) 관측 실습을 할 때만 채운다 ─────────────────────

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
