# =============================================================================
# .env.sample - connection settings template for the "AI Agent development" course
# =============================================================================
#
# QUICK START (for people)
#   1. Copy this file to the top of the repository and name the copy .env
#      (exactly ".env": Windows Explorer hides extensions, so watch out for ".env.txt").
#   2. In section (1) set COURSE_ENV to samsung (inside the company network) or out (outside it).
#   3. Fill in only the section that matches: (2) inside values or (3) outside values.
#      Inside values come from the internal training page (environment / API key setup
#      guide) or from the instructor.
#   4. Check: from the top of the repository run  uv run python -m config.check
#      (or run the environment-check cell at the top of a lab notebook).
#      You are done when no line has a no-entry sign. Follow the hint under each line that has one.
#   5. After editing .env, restart the notebook kernel and run the notebook from its first cell.
#      The values are read once, when the notebook imports config.
#
# NOTES FOR AI ASSISTANTS (read this before helping with setup)
#   - This template has no secrets: read and quote it freely. The real .env holds secrets:
#     never print, quote, log, paste into chat or commit any value from it.
#   - To see what is set without seeing values, run  uv run python -m config.check --json
#     (names and status only). Add --live for one real call to the model and the embeddings,
#     and --langfuse when the Langfuse values are needed.
#   - Never invent a value. Never hard-code a URL, model name or key in code: get models from
#     config.llm.get_llm() and config.embeddings.get_embeddings(), and RAGaaS from
#     config.ragaas.post_ragaas(). If a value is missing, tell the user which name is missing
#     and where it comes from (see the entry for that name below).
#   - Loader: course/config/__init__.py (python-dotenv). It uses the nearest .env found by
#     walking up from the current folder, reads it as UTF-8 (falls back to cp949 with a notice
#     on stderr) and does not override variables that are already set in the OS environment.
#   - An empty value (KEY=) counts as not set.
#   - Create or edit .env with the editor or a file-writing tool. Never use shell redirection
#     such as echo KEY=value > .env in Windows PowerShell 5.1: it writes UTF-16, which config
#     cannot read.
#   - .env is git-ignored (.gitignore has .env and .env.*, except .env.sample). Never commit it.
#
# FILE RULES (why this file looks the way it does)
#   - Comments are English and ASCII only, so any editor saves identical bytes. Korean Windows
#     tools may save cp949, which would otherwise break "import config". Keep .env as UTF-8
#     without BOM.
#   - Write a comment on its own line above a value. Never put a comment after an empty value:
#     "KEY=   # note" is read as the value "# note". No quotes are needed around values.
#   - The section numbers (1)-(4) are referenced by course/agent_docs/setup.md.
#
# WHICH LAB NEEDS WHICH VALUES (the lecture notebooks need none)
#   LLM only ................................. 1-2, 1-3, 2-1, 2-2, 3-2, 3-3, 3-4, 4-1
#   LLM + embeddings ......................... 2-3, 3-1
#   LLM + embeddings + RAGaaS ................ 1-4
#   LLM + Langfuse ........................... 4-2
#   LLM + embeddings + RAGaaS + Langfuse ..... 4-3 (capstone)
#
# COMMON PROBLEMS
#   - A RuntimeError that lists missing names, or says a name "is required"
#       -> that value is empty. Fill it in (or fix COURSE_ENV).
#   - 401 / AuthenticationError -> wrong or expired key or ticket. Copy it again from its
#       source, without spaces or quotes. Never print it to check.
#   - 404 "model does not exist" -> OPENAI_MODEL (inside: model) is wrong.
#   - Connection error or timeout -> inside values work only inside the company network.
#       Outside it, use COURSE_ENV=out.
#   - Changed .env but nothing changed -> restart the kernel and run from the first cell.
#   - A notice about cp949, or "cannot read" when importing config -> save .env as UTF-8
#       (VS Code: click the encoding at the bottom right, Save with Encoding, UTF-8).
#   - A value that starts with "#" -> a comment was written after an empty value. Move it
#       to its own line.
#
# More: course/agent_docs/setup.md, course/agent_docs/troubleshooting.md, course/agent_docs/paths.md
# =============================================================================


# (1) COURSE_ENV - which network you work in. Set only this one line; config derives the rest.
#
# COURSE_ENV
#   Needed: always.
#   Values: samsung or out (also accepted: intranet, external, openai).
#     samsung  Inside the company network (classroom PC). LLM, embeddings and RAGaaS all use
#              the internal APIs. Fill in section (2).
#     out      Outside the company network. LLM and embeddings use OpenAI and RAGaaS returns
#              mock answers without any network call. Fill in section (3).
#   Effect: config sets the three providers below from it (samsung: samsung, samsung, samsung;
#           out: openai, openai, mock).
#   If unset: every provider falls back to its own default (samsung) and config.check warns.
COURSE_ENV=samsung

# (Advanced) Per-connection overrides. Remove the leading # only when one connection must
# differ from COURSE_ENV. A value set here wins over COURSE_ENV (config only fills providers
# that are left unset).
# LLM_PROVIDER=samsung      # samsung or openai. Read by config.llm.get_llm().
# EMBED_PROVIDER=samsung    # samsung or openai. Read by config.embeddings.get_embeddings().
# RAG_PROVIDER=samsung      # samsung or mock. Read by config.ragaas.post_ragaas().


# (2) INSIDE VALUES - needed when COURSE_ENV=samsung
# Credentials and internal addresses: never print, share or commit them.
# Where they come from: the internal training page (environment / API key setup guide) or
# the instructor. config/samsung.py turns them into requests; a missing name raises a
# RuntimeError that lists the missing names.

# --- LLM gateway: all five values are required (config.samsung.llm_config) ---

# api_base_url
#   Base URL of the internal OpenAI-compatible LLM gateway. Do not add /chat/completions:
#   the client appends it. A trailing slash is fine.
api_base_url=
# credential_key
#   Gateway credential. Sent as the x-dep-ticket HTTP header. Secret.
credential_key=
# send_system_name
#   System name written in your approval document. Sent as the Send-System-Name header.
send_system_name=
# model
#   Model name to request. The course code originally used private-model.1-260330; the value
#   on the training page takes priority.
model=
# user_id
#   Your AD ID. Sent as the User-Id header together with User-Type: AD_ID.
user_id=

# --- Embeddings: both values are required (config.samsung.embedding_config) ---
# Used by labs 1-4, 2-3, 3-1 and 4-3. Texts are sent to the API 10 at a time.

# embedding_api_url
#   Base URL of the internal embedding API. Do not add /v1/embeddings: the code appends it.
embedding_api_url=
# embedding_x_dep_ticket
#   Embedding API credential. Sent as the x-dep-ticket header. Secret.
embedding_x_dep_ticket=

# --- RAGaaS: three values are required (config.samsung.ragaas_config) ---
# Used by the RAGaaS chapter of lab 1-4 and by the 4-3 capstone. Requests go to
# <search_url>/dsllmrag/elastic/v2/<endpoint> with the endpoints insert-doc, retrieve-rrf
# and delete-doc.

# search_url
#   Base URL of RAGaaS. The code appends /dsllmrag/elastic/v2/<endpoint>.
search_url=
# rag_credential_key
#   RAGaaS credential. Sent as the x-dep-ticket header. Secret.
rag_credential_key=
# rag_api_key
#   RAGaaS API key. Sent as the api-key header. RAGaaS needs both this and
#   rag_credential_key. Secret.
rag_api_key=
# index_name
#   RAGaaS index to search. Read by the 1-4 RAGaaS lab and by the capstone. Required when the
#   RAG provider is samsung (with mock, a fake index name is used). The value below is the
#   training index (pet insurance terms) that the labs expect: keep it unless the instructor
#   says otherwise.
index_name=rp-aicoa-meritz-pet


# (3) OUTSIDE VALUES - needed when COURSE_ENV=out
# The labs then call the OpenAI API with your own account. RAGaaS is mocked, so it needs no
# values.

# OPENAI_API_KEY
#   Your OpenAI API key (starts with sk-). Used for both chat and embeddings. Secret.
OPENAI_API_KEY=
# OPENAI_MODEL
#   Chat model your account can use, for example gpt-4o-mini.
OPENAI_MODEL=
# OPENAI_EMBEDDING_MODEL
#   Embedding model your account can use, for example text-embedding-3-small.
OPENAI_EMBEDDING_MODEL=


# (4) LANGFUSE - needed only for the Part 2 observability labs (4-2 and the 4-3 capstone)
# Langfuse stores traces and scores of your runs. The Langfuse SDK reads these three names
# from the environment by itself; check them with  uv run python -m config.check --langfuse
# Ask the instructor which Langfuse server and project keys to use.

# LANGFUSE_SECRET_KEY
#   Project secret key (starts with sk-lf-). Secret.
LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY
#   Project public key (starts with pk-lf-).
LANGFUSE_PUBLIC_KEY=
# LANGFUSE_BASE_URL
#   Address of the Langfuse server. The default below is a Langfuse cloud address (Japan
#   region). Replace it with the address of the server you were told to use (for a
#   self-hosted server, its own address). config.check also accepts the older name
#   LANGFUSE_HOST.
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
