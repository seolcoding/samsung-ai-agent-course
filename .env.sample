# 이 파일을 .env.external 또는 .env.internal로 복사한 뒤 필요한 값만 채우세요.
# 실행할 때 uv run --env-file .env.external 또는 .env.internal을 지정합니다.
# 선택하지 않은 .env 파일이 섞이지 않도록 python-dotenv의 자동 로드를 끕니다.
PYTHON_DOTENV_DISABLED=1
# 사외 예시. 사내 파일에서는 두 PROVIDER를 samsung으로 바꾸세요.
LLM_PROVIDER=openai
EMBED_PROVIDER=openai
RAG_PROVIDER=mock

# 사외 OpenAI. 실제 키와 사용 가능한 모델명은 로컬 환경 파일에만 기록합니다.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

# ── Langfuse (Chapter02/05-observability 모듈) ────────────────────────────────
# Langfuse 실습을 실행할 때만 채웁니다.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com

# ── 삼성 사내 환경 (강사 전용, 사내망에서만 동작) ──────────────────────────────
# 사내 파일에서는 RAG_PROVIDER=samsung으로 바꾸세요.
api_base_url=
credential_key=
send_system_name=
model=
user_id=

# ── 임베딩
embedding_api_url=
embedding_x_dep_ticket=

# ── RAG
search_url=
rag_credential_key=
rag_api_key=
index_name=
